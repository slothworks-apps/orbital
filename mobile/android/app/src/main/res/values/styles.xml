<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- The app is dark whatever the system theme: light status bar icons on the space colour (@color/orbitalSpace). -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/orbitalSpace</item>
        <item name="android:statusBarColor">@color/orbitalSpace</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <!--
      The launch screen (Claude Design, "Feature - Splash screen", 1a): the mark
      held still on the space colour until the web app's first screen has
      painted (@capacitor/splash-screen, launchAutoHide off). core-splashscreen
      maps the two windowSplashScreen* items onto Android 12+'s own splash;
      older versions draw the window background, @drawable/splash, instead.
      No icon background: the mark is not the launcher's tile.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/orbitalSpace</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>