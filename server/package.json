{
  "name": "@orbital/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/index.mjs --external:better-sqlite3 --external:@anthropic-ai/claude-agent-sdk --banner:js=\"import { createRequire as __orbitalCreateRequire } from 'node:module'; const require = __orbitalCreateRequire(import.meta.url);\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "@noble/hashes": "^2.0.0",
    "@orbital/shared": "*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@orbital/relay": "*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
