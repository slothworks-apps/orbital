#!/bin/sh
# The orbital package's postinst (spec 2026-10-19-headless-server-design →
# The package, The root updater).
set -e

# The user `orbital setup` recorded, when it is a user on this machine.
service_user() {
  [ -r /etc/orbital/user ] || return 0
  u="$(head -n 1 /etc/orbital/user | tr -d '[:space:]')"
  case "$u" in
    '' | -* | *[!A-Za-z0-9_.-]*) return 0 ;;
  esac
  if id -u "$u" >/dev/null 2>&1; then printf '%s\n' "$u"; fi
}

if [ "$1" = configure ]; then
  user="$(service_user)"
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
    # A server set up before the update channel existed gets its watcher with
    # the upgrade: it is often updated from the group, where no one sees the
    # line asking for orbital setup. Only where setup turned the updater on.
    # Before the server restarts, so the channel it writes at its start is
    # seen.
    if systemctl is-enabled --quiet orbital-update.path 2>/dev/null \
      && ! systemctl is-enabled --quiet orbital-channel.path 2>/dev/null; then
      systemctl enable --now orbital-channel.path || true
    fi
    if [ -n "$user" ]; then
      # Reload first, so a changed orbital.service is what restarts. Only an
      # enabled unit: one its user turned off stays off. A user manager that
      # is not running (no linger, no login) is not an error.
      systemctl --user -M "$user@" daemon-reload || true
      if systemctl --user -M "$user@" is-enabled --quiet orbital.service 2>/dev/null; then
        systemctl --user -M "$user@" restart orbital.service || true
      fi
    fi
    # PathChanged= does not fire for a channel file written before the
    # watcher was on, so the channel is applied once now. --no-block: this
    # may run inside orbital-update.service, whose lock the channel run
    # waits for. The updater itself does nothing before orbital setup.
    if [ -n "$user" ] && systemctl is-enabled --quiet orbital-channel.path 2>/dev/null; then
      systemctl start --no-block orbital-channel.service || true
    fi
  fi
  # Setup is due on a first install, and again after a remove and an
  # install: prerm turned the updater and the user's unit off.
  set_up=yes
  if [ -z "$user" ]; then
    set_up=no
  elif ! systemctl is-enabled --quiet orbital-update.path 2>/dev/null; then
    set_up=no
  elif ! systemctl is-enabled --quiet orbital-channel.path 2>/dev/null; then
    # A server set up before the channel: setup turns its watcher on.
    set_up=no
  elif ! systemctl --user -M "$user@" is-enabled --quiet orbital.service 2>/dev/null; then
    set_up=no
  fi
  if [ "$set_up" = no ]; then
    echo "Run as yourself: orbital setup"
  fi
fi

exit 0
