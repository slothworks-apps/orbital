#!/bin/sh
# Commit messages carry no attribution: no Co-authored-by trailer, for a
# person or a tool, and no "Generated with" footer. The author field says
# who wrote the commit. Edit the message and commit again.

pattern='^co-authored-by:|generated with'
if grep -qiE "$pattern" "$1"; then
  echo "commit-msg: the message carries an attribution line — remove it." >&2
  grep -inE "$pattern" "$1" >&2
  exit 1
fi
