{
  "name": "@orbital/desktop",
  "version": "0.20.11",
  "description": "Orbital as a macOS desktop app: the window, the notifications and the server's lifecycle.",
  "author": "SlothWorks s.r.o.",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main.cjs && esbuild src/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs",
    "dev": "npm run build && ORBITAL_DESKTOP_DEV=1 electron .",
    "dist": "npm run build && APPLE_KEYCHAIN_PROFILE=${APPLE_KEYCHAIN_PROFILE:-orbital-notary} electron-builder --mac --arm64",
    "dist:local": "npm run build && electron-builder --mac --arm64 -c.mac.notarize=false -c.directories.output=release/local '-c.dmg.artifactName=${productName}-${version}-${arch}-local.${ext}'",
    "dist:self": "npm run build && electron-builder --mac --arm64 '-c.mac.identity=Orbital Local' -c.mac.notarize=false -c.directories.output=release/local '-c.dmg.artifactName=${productName}-${version}-${arch}-local.${ext}'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@orbital/shared": "*",
    "@types/node": "^24.19.1",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
