{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbital-site",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "orbital.slothworks.io",
      "custom_domain": true
    }
  ]
}
