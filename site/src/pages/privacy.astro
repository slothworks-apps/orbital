---
/**
 * The privacy policy. The page is Claude Design's "Privacy.dc.html"; the text
 * is site/content/privacy.md, the maintainer's, rendered into it: its title
 * as the h1, its "Last updated" line in the meta row, its first paragraph as
 * the lead, and the rest in the body style.
 */
import Base from '../layouts/Base.astro'
import Background from '../components/Background.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { compiledContent } from '../../content/privacy.md'

const html = await compiledContent()

// The page needs the policy's opening split from its body. Fail the build
// rather than render a page with the date or the title in the wrong place.
const opening = /^\s*<h1[^>]*>([\s\S]*?)<\/h1>\s*<p>Last updated:\s*([\s\S]*?)<\/p>\s*<p>([\s\S]*?)<\/p>([\s\S]*)$/.exec(
  html,
)
if (!opening) {
  throw new Error(
    'site/content/privacy.md must open with "# <title>", a "Last updated: <date>" line and an intro paragraph',
  )
}
const [, heading = '', updated = '', intro = '', body = ''] = opening

// The canvas sets the lead's first sentence in white, as the landing does
// with its leads. Bold in the markdown wins if the text ever carries it.
const lead = intro.includes('<strong>') ? intro : intro.replace(/^([^.]*\.)/, '<strong>$1</strong>')
---

<Base
  title="Privacy — Orbital"
  description="What the Orbital Mac app, the phone apps, the relay and this website do with your data, who else is involved, and how to get anything deleted."
  label="Privacy"
>
  <Background variant="privacy" />

  <Header home="/">
    <a href="/" class="back">← Back to Orbital</a>
  </Header>

  <main class="policy">
    <div class="eyebrow">PRIVACY POLICY</div>
    <h1><span set:html={heading} /></h1>
    <div class="meta">
      <span>Last updated · <Fragment set:html={updated} /></span>
      <span class="applies">Applies to the Mac app, the phone apps and this site</span>
    </div>
    <p class="lead" set:html={lead} />
    <div class="body" set:html={body} />
  </main>

  <Footer current="privacy" />
</Base>

<style>
  .back {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: rgba(160, 190, 225, 0.75);
  }
  .back:hover {
    color: #e8eef8;
  }
  .policy {
    position: relative;
    max-width: 680px;
    margin: 0 auto;
    padding: clamp(56px, 9cqw, 112px) clamp(20px, 5cqw, 48px) 0;
  }
  .eyebrow {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    color: rgba(160, 190, 225, 0.6);
  }
  h1 {
    margin: 16px 0 0;
    font-size: clamp(40px, 6cqw, 64px);
    line-height: 1.02;
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  h1 span {
    display: inline-block;
    padding: 0 0.04em 0.08em;
    background: linear-gradient(105deg, #ffffff 0%, #dcecff 38%, oklch(58% 0.06 232) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    filter: drop-shadow(0 0 40px oklch(85% 0.12 205 / 0.2));
  }
  .meta {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-family: var(--mono);
    font-size: 12px;
    color: rgba(160, 190, 225, 0.7);
  }
  .applies {
    color: rgba(160, 190, 225, 0.45);
  }
  .lead {
    margin: 40px 0 0;
    font-size: clamp(18px, 1.6cqw, 20px);
    line-height: 1.6;
    color: #e8eef8;
    text-wrap: pretty;
  }
  .lead :global(strong) {
    color: #ffffff;
    font-weight: 600;
  }

  /* The markdown's own elements, which carry no scope attribute. */
  .body :global(h2) {
    margin: 56px 0 0;
    font-size: 22px;
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .body :global(p) {
    margin: 14px 0 0;
    font-size: 16.5px;
    line-height: 1.7;
    color: rgba(214, 226, 242, 0.86);
    text-wrap: pretty;
  }
  .body :global(ul) {
    margin: 14px 0 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 16.5px;
    line-height: 1.7;
    color: rgba(214, 226, 242, 0.86);
  }
  /* Not in the canvas: the body's run-in bold and inline code. Kept to the
     page's own type, emphasis weight and ink. */
  .body :global(strong) {
    font-weight: 600;
    color: #e8eef8;
  }
  .body :global(code) {
    font-family: var(--mono);
    font-size: 0.86em;
  }
</style>
